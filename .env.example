# CodeMentor configuration. Copy to .env.local for development (`npm run setup` does it for you)
# or set these as environment variables in Hostinger hPanel / your VPS service file.
# NEVER commit real values.

# ── Web app ─────────────────────────────────────────────────────────────────
# Hostinger provides PORT automatically; `npm start` (= next start) honours it. Local dev uses 3400.
# PORT=3000
NODE_ENV=production

# Trust X-Forwarded-For from YOUR reverse proxy (nginx/Caddy on a VPS, Hostinger's proxy on managed
# hosting). Needed for per-network rate limits; without it those layers are skipped (never spoofable).
TRUST_PROXY=true

# ── Database (PostgreSQL in production — required) ──────────────────────────
# Without DATABASE_URL the app uses embedded PGlite in CODEMENTOR_DATA_DIR (development only; refused
# in production unless ALLOW_PGLITE_IN_PRODUCTION=true for a private trial on persistent storage).
DATABASE_URL=postgres://codementor:CHANGE_ME@127.0.0.1:5432/codementor
# DATABASE_SSL=require            # for a remote/managed PostgreSQL
# DATABASE_POOL_MAX=10
# Run migrations at startup (default true). Set false and use `npm run db:migrate` in a deploy step instead.
AUTO_MIGRATE=true
# CODEMENTOR_DATA_DIR=./.data
# ALLOW_PGLITE_IN_PRODUCTION=false

# ── Sessions & guests ───────────────────────────────────────────────────────
SESSION_DAYS=14
GUEST_SESSION_DAYS=180
GUEST_CREATIONS_PER_HOUR=600
# 32+ random characters. Keys the one-way hashes of AI quota counters. Required in production for AI.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_SECRET=

# ── Code execution (separate sandbox worker; see docs/SANDBOX.md) ───────────
# none | sandbox-worker | piston
EXECUTION_PROVIDER=none
SANDBOX_URL=http://127.0.0.1:3410
SANDBOX_TOKEN=
# Safety gate: in production, code runs ONLY if this is true AND the worker reports a production
# backend (docker). Leave false until the launch checks in docs/LAUNCH-CHECKLIST.md pass.
EXECUTION_PUBLIC_ENABLED=false
EXECUTION_MAX_CONCURRENT=4
EXECUTION_MAX_QUEUED=20

# ── Sandbox worker process (worker/sandbox, on the VPS) ─────────────────────
# SANDBOX_HOST=127.0.0.1
# SANDBOX_PORT=3410
# SANDBOX_BACKEND=docker
# SANDBOX_DOCKER_IMAGE=gcc:14
# SANDBOX_DOCKER_RUNTIME=runsc     # gVisor — required in production unless SANDBOX_ALLOW_RUNC=1
# SANDBOX_ALLOW_RUNC=0
# SANDBOX_CONCURRENCY=2
# SANDBOX_MAX_QUEUE=16

# ── AI mentor (optional — everything works in curated mode) ─────────────────
# curated | claude | openai | auto. An explicitly chosen provider that isn't fully configured means
# curated mode — the app never silently switches to the other provider.
AI_PROVIDER=curated
# Providers "auto" may use, in order.
AI_AUTO_ORDER=claude,openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Built-in list prices exist for current Claude models; set both to override.
# ANTHROPIC_INPUT_USD_PER_MTOK=
# ANTHROPIC_OUTPUT_USD_PER_MTOK=

OPENAI_API_KEY=
# No default: set a model you have verified in your OpenAI account.
OPENAI_MODEL=
# Required for OpenAI (the budget can't be enforced without prices). Check current pricing.
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=
# OPENAI_REASONING_EFFORT=low

# ── AI cost controls (see docs/AI-AND-COSTS.md) ─────────────────────────────
AI_MONTHLY_BUDGET_USD=20
AI_DAILY_REQUEST_LIMIT=10
AI_AUTO_DAILY_LIMIT=40
AI_IP_DAILY_LIMIT=300
AI_GLOBAL_DAILY_LIMIT=3000
AI_QUOTA_TZ_OFFSET_MINUTES=330
AI_MAX_CONCURRENT=4
AI_MAX_QUEUED=16
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_INPUT_CHARS=12000
